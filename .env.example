# Copy to .env (or export in your shell) before running.

# --- Text model provider ---
# "bedrock" (default, what the hackathon rewards), "anthropic" (fallback
# for local dev/demo while AWS Bedrock access/billing is being sorted), or
# "gemini" (used live for the platform backend once the Anthropic key ran
# out of credit mid-hackathon -- see dadhero/agent.py's _resolve_model()).
DADHERO_MODEL_PROVIDER=bedrock

# --- Bedrock (used when DADHERO_MODEL_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
DADHERO_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS credentials picked up from ~/.aws/credentials or AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY env vars -- not set here.

# --- Anthropic direct (used when DADHERO_MODEL_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- Image provider ---
# "mock" (default -- zero cost, draws a labeled placeholder so the full
# pipeline runs with no API key) or "gemini" (real Nano Banana art,
# UNVERIFIED as of this writing -- see README status section).
DADHERO_IMAGE_PROVIDER=mock
GEMINI_API_KEY=
