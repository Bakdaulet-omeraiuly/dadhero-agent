SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...   # Settings -> API -> API Keys -> Publishable key (new key system) -- or the legacy "anon public" eyJ... key on an older project
GEMINI_API_KEY=...
DADHERO_CORS_ORIGINS=http://localhost:5173

# No SUPABASE_JWT_SECRET here -- auth.py verifies via the project's JWKS
# endpoint (Settings -> API -> JWT Keys -> "JWT Signing Keys" tab), which
# needs only SUPABASE_URL above. Only add a JWT_SECRET var back if your
# project is on the "Legacy JWT Secret" tab instead -- check before
# assuming, see auth.py's docstring.
